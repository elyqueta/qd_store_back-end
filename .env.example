NODE_ENV=development
PORT=3000
# 0 = acesso directo/local; 1 = um proxy à frente (configuração típica em cloud).
TRUST_PROXY=0
DATABASE_URL=postgres://qd_user:qd_password@localhost:5433/qd_store

CORS_ORIGIN=http://localhost:1914,http://localhost:5173,https://qd-store-one.vercel.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Gere com: openssl rand -base64 48
JWT_SECRET=troque_este_valor_por_um_segredo_forte_de_producao
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

BCRYPT_SALT_ROUNDS=12

PAYMENT_GATEWAY=mock
PAYMENT_MOCK_FAIL_PHONE=900000000
PAYMENT_REFERENCE_TTL_HOURS=72
# Entidade e dados bancários são fictícios e devem ser substituídos antes de produção.
PAYMENT_MULTICAIXA_ENTITY=00000
BANK_TRANSFER_IBAN=AO06000000000000000000000
BANK_TRANSFER_BANK=Banco Exemplo
BANK_TRANSFER_HOLDER=QD Solutions (DADOS FICTÍCIOS)