NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://qd_user:qd_password@localhost:5432/qd_store

# Origens (front-ends) autorizadas a consumir a API via browser.
# Separadas por vírgula, sem espaços extras necessários (são
# removidos automaticamente). Em produção, usar o domínio real do
# front-end (ex: https://qd-store.vercel.app).
CORS_ORIGIN=http://localhost:5173,http://localhost:4173

# Rate limiting (aplicado apenas às rotas /api/*)
# Janela de tempo em milissegundos e número máximo de requisições
# por IP dentro dessa janela.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
